{
  "name": "controlhub",
  "version": "1.0.0",
  "description": "ControlHub: Belegung, Kacheln und Spieldaten für CraftConsole, CraftLink und eigene Controller",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "build": "pkg . --output dist/ControllerServer.exe --targets node18-win-x64",
    "build:all": "pkg . --output dist/ControllerServer --targets node18-win-x64,node18-macos-x64,node18-linux-x64"
  },
  "bin": "server/index.js",
  "pkg": {
    "assets": [
      "public/**/*",
      "server/config/modules.js",
      "vorgaben/**/*"
    ],
    "outputPath": "dist"
  },
  "keywords": [
    "arduino",
    "controller",
    "hid",
    "gamepad",
    "keyboard"
  ],
  "author": "Hendrik Kleinwächter",
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "express": "^4.18.2",
    "serialport": "^12.0.0",
    "socket.io": "^4.6.1"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "controlhub": {
    "updateRepo": "HendrikKleinwaechter/ControlHub"
  }
}
